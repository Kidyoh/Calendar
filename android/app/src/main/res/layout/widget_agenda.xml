<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/glass_bg" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/face_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/glass_pill" android:paddingStart="10dp" android:paddingTop="4dp" android:paddingEnd="12dp"
        android:paddingBottom="4dp" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
            android:ellipsize="end" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/add" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/glass_pill"
            android:paddingStart="10dp" android:paddingTop="3dp" android:paddingEnd="10dp" android:paddingBottom="3dp" android:text="＋" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="#B3FFFFFF" android:textSize="13sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/ar0" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/ab0" android:layout_width="4dp" android:layout_height="match_parent" android:background="#FFBDB4D4" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="9dp" android:orientation="vertical">
            <TextView android:id="@+id/at0" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:textColor="#B3FFFFFF" android:textSize="11sp" />
            <TextView android:id="@+id/an0" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/ar1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/ab1" android:layout_width="4dp" android:layout_height="match_parent" android:background="#FFBDB4D4" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="9dp" android:orientation="vertical">
            <TextView android:id="@+id/at1" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:textColor="#B3FFFFFF" android:textSize="11sp" />
            <TextView android:id="@+id/an1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/ar2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/ab2" android:layout_width="4dp" android:layout_height="match_parent" android:background="#FFBDB4D4" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="9dp" android:orientation="vertical">
            <TextView android:id="@+id/at2" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:textColor="#B3FFFFFF" android:textSize="11sp" />
            <TextView android:id="@+id/an2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/ar3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/ab3" android:layout_width="4dp" android:layout_height="match_parent" android:background="#FFBDB4D4" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="9dp" android:orientation="vertical">
            <TextView android:id="@+id/at3" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:textColor="#B3FFFFFF" android:textSize="11sp" />
            <TextView android:id="@+id/an3" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/ar4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/ab4" android:layout_width="4dp" android:layout_height="match_parent" android:background="#FFBDB4D4" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="9dp" android:orientation="vertical">
            <TextView android:id="@+id/at4" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:textColor="#B3FFFFFF" android:textSize="11sp" />
            <TextView android:id="@+id/an4" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/ar5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/ab5" android:layout_width="4dp" android:layout_height="match_parent" android:background="#FFBDB4D4" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="9dp" android:orientation="vertical">
            <TextView android:id="@+id/at5" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:textColor="#B3FFFFFF" android:textSize="11sp" />
            <TextView android:id="@+id/an5" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
