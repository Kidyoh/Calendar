<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/glass_bg" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/wd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.1" android:textColor="#B3FFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-light" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="52sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
            <TextView android:id="@+id/face_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/glass_pill" android:paddingStart="10dp" android:paddingTop="4dp" android:paddingEnd="12dp"
        android:paddingBottom="4dp" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="18sp" />
            <TextView android:id="@+id/line" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="#E6FFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/line2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:textColor="#B3FFFFFF" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
