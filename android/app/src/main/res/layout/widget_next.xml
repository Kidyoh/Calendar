<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/island_bg" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/head" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FF9A9A9A" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF9A9A9A" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/time" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:textColor="#FFBDBDBD" android:textSize="13sp" />
    <ImageView android:id="@+id/bar" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="10dp" android:scaleType="fitXY" />
</LinearLayout>
